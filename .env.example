# Optional local persistence. Omit both variables for in-memory fixture mode.
BURSAR_DATABASE_PATH=data/bursar.db
# Alternatively: BURSAR_DATABASE_URL=sqlite:///absolute/path/to/bursar.db
SWITCH_BASE_URL=https://mattermost.example.com
SWITCH_TOKEN=replace-with-personal-access-token
SWITCH_TEAM_ID=replace-with-team-id
SWITCH_CHANNEL_ID=
SWITCH_TIMEOUT_SECONDS=10
# Legacy/provider-neutral Mattermost adapter compatibility only; not the
# verified Switch-primary demo path above.
# Official Switch agent protocol (preferred live path; provisioned by Switch Console)
SWITCH_AGENT_BASE_URL=http://127.0.0.1:replace-with-agent-port
SWITCH_AGENT_ID=replace-with-switch-agent-id
SWITCH_AGENT_NAME=bursar-reviewer
SWITCH_AGENT_API_KEY=replace-with-switch-agent-api-key
SWITCH_ROOM_ID=replace-with-bursar-room-id
SWITCH_AGENT_TIMEOUT_SECONDS=10
# Optional: persist the SSE connection identity across restarts
SWITCH_CONNECTION_ID=
MODEL_API_KEY=replace-with-model-api-key
MODEL_BASE_URL=https://model-provider.example.com/v1
MODEL_NAME=replace-with-model-name
MODEL_TIMEOUT_SECONDS=20
